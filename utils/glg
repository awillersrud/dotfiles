#!/usr/bin/env bash
# git log show with fzf
# Accepts the same arguments as git log, e.g. glg --author bob origin/main -- docs
glg() {

  # param validation
  if [[ ! $(git log -n 1 "$@" | head -n 1) ]]; then
    return
  fi

  # paths after -- also limit the diff shown for each commit
  local filter=""
  local paths=() seen_separator=""
  for arg in "$@"; do
    if [[ -n $seen_separator ]]; then
      paths+=("$arg")
    elif [[ $arg == "--" ]]; then
      seen_separator=1
    fi
  done
  if (( ${#paths[@]} )); then
    filter="-- $(printf '%q ' "${paths[@]}")"
  fi

  git log --graph --color=always --abbrev=7 --format='%C(auto)%h %an %C(blue)%s %C(yellow)%cr' "$@" | \
  fzf --ansi --no-sort --reverse --tiebreak=index \
    --preview "f() { set -- \$(echo -- \$@ | grep -o '[a-f0-9]\{7\}'); [ \$# -eq 0 ] || git show --color=always \$1 $filter; }; f {}" \
    --bind "?:toggle-preview" \
    --bind "ctrl-d:half-page-down,ctrl-u:half-page-up,ctrl-j:preview-down,ctrl-k:preview-up,ctrl-f:preview-page-down,ctrl-b:preview-page-up" \
    --bind "ctrl-s:execute:
                (grep -o '[a-f0-9]\{7\}' | head -1 |
                xargs -I % sh -c 'git show --color=always % $filter | less -R') << 'FZF-EOF'
                {}
                FZF-EOF" \
    --bind "ctrl-y:execute-silent:
                (grep -o '[a-f0-9]\{7\}' | head -1 |
                pbcopy) << 'FZF-EOF'
                {}
                FZF-EOF"

}

glg "$@" | grep -o '[a-f0-9]\{7\}'
