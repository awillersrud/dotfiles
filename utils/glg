# git log show with fzf
glg() {

  # param validation
  if [[ ! `git log -n 1 $@ | head -n 1` ]] ;then
    return
  fi

  # filter by file string
  local filter
  # param existed, git log for file if existed
  if [ -n $@ ] && [ -f $@ ]; then
    filter="-- $@"
  fi

  # git command
  
  #enable debug logging
  #set -x
  #echo "filter: $filter"
  #echo "\$@: $@"

  git log --graph --color=always --abbrev=7 --format='%C(auto)%h %an %C(blue)%s %C(yellow)%cr' $filter | \
  fzf --ansi --no-sort --reverse --tiebreak=index \
    --preview "f() { set -- \$(echo -- \$@ | grep -o '[a-f0-9]\{7\}'); [ \$# -eq 0 ] || git show --color=always \$1 $filter; }; f {}" \
    --bind "?:toggle-preview" \
    --bind "ctrl-d:half-page-down,ctrl-u:half-page-up,ctrl-j:preview-down,ctrl-k:preview-up,ctrl-f:preview-page-down,ctrl-b:preview-page-up" \
    --bind "ctrl-s:execute:
                (grep -o '[a-f0-9]\{7\}' | head -1 |
                xargs -I % sh -c 'git show --color=always % $filter | less -R') << 'FZF-EOF'
                {}
                FZF-EOF" \
    --bind "ctrl-y:execute-silent:
                (grep -o '[a-f0-9]\{7\}' | head -1 |
                pbcopy) << 'FZF-EOF'
                {}
                FZF-EOF"

}

glg | grep -o '[a-f0-9]\{7\}'